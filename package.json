{
  "name": "dcs-prep",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "scripts": {
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "copy-pdf-worker": "node scripts/copy-pdf-worker.mjs",
    "dev": "next dev",
    "dev:3000": "cross-env PORT=3000 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --config eslint.config.cjs . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --project=chromium --project=mobile-chrome"
  },
  "dependencies": {
    "lucide-react": "^1.73.0",
    "next": "^16.4.5",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.1",
    "react-dom": "18.2.0",
    "zod": "4.6.7",
    "zustand": "4.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/react": "14.0.0",
    "@types/node": "^24.11.0",
    "@types/react": "19.3.0",
    "autoprefixer": "10.6.2",
    "cross-env": "7.0.3",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8.5.32",
    "tailwindcss": "3.4.10",
    "typescript": "5.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "vite": "8.3.8",
    "source-map-js": "1.2.2"
  }
}
